#!/usr/bin/env bash
# tkt - a file-based ticket system with dependency tracking.
# Requires Bash and standard Unix tools. The query command also requires jq.
set -euo pipefail
shopt -s nullglob

# --- Configuration ---
TICKETS_DIR_NAME=".tickets"
TICKETS_DIR_PATH="${TICKETS_DIR_PATH:-}"
VALID_STATUSES="open in_progress closed"
VALID_TYPES="bug feature task epic chore"
VALID_PRIORITIES="0 1 2 3 4"
DEFAULT_PRIORITY=2
DEFAULT_ISSUE_TYPE="task"
# ---------------------

init_tickets_dir() {
    if [[ -z "$TICKETS_DIR_PATH" ]]; then
        local dir="$PWD"
        while [[ ! -d "$dir/$TICKETS_DIR_NAME" && "$dir" != / ]]; do
            dir=${dir%/*}
            dir=${dir:-/}
        done
        if [[ -d "$dir/$TICKETS_DIR_NAME" ]]; then
            TICKETS_DIR_PATH="$dir/$TICKETS_DIR_NAME"
        else
            TICKETS_DIR_PATH="$PWD/$TICKETS_DIR_NAME"
        fi
    fi
    mkdir -p "$TICKETS_DIR_PATH"
    TICKETS_DIR_PATH=$(cd "$TICKETS_DIR_PATH" && pwd)
}

_iso_date() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Only the initial --- block is frontmatter. Body separators never reopen it.
# All readers and writers use the same field and inline-list rules.
AWK_FRONTMATTER='
function trim(value) {
    sub(/^[ \t]+/, "", value)
    sub(/[ \t]+$/, "", value)
    return value
}
function parse_list(value, items,    n, i) {
    sub(/^\[/, "", value)
    sub(/\]$/, "", value)
    value = trim(value)
    if (value == "") return 0
    n = split(value, items, ",")
    for (i = 1; i <= n; i++) items[i] = trim(items[i])
    return n
}
{
    field_key = ""; field_value = ""
    front_start = (FNR == 1 && $0 == "---")
    front_end = (FNR > 1 && in_front && $0 == "---")
    if (FNR == 1) in_front = front_start
    if (front_end) in_front = 0
    if (in_front && !front_start && match($0, /^[a-zA-Z][a-zA-Z0-9_-]*:/)) {
        field_key = substr($0, 1, RLENGTH - 1)
        field_value = trim(substr($0, RLENGTH + 1))
    }
}
'

AWK_TICKETS="$AWK_FRONTMATTER"'
FNR == 1 {
    if (prev_file) store()
    delete fields; delete field_keys
    field_count = 0; title = ""
    prev_file = FILENAME
}
field_key != "" {
    if (!(field_key in fields)) field_keys[++field_count] = field_key
    fields[field_key] = field_value
}
!in_front && /^# / && title == "" { title = substr($0, 3) }
function store(    id, i, key) {
    id = fields["id"]
    if (id == "") return
    ids[++ticket_count] = id
    titles[id] = title
    files[id] = prev_file
    key_count[id] = field_count
    for (i = 1; i <= field_count; i++) {
        key = field_keys[i]
        keys[id, i] = key
        data[id, key] = fields[key]
    }
}
function active(id) {
    return data[id, "status"] == "open" || data[id, "status"] == "in_progress"
}
function blockers(id,    n, items, i, out) {
    n = parse_list(data[id, "deps"], items)
    out = ""
    for (i = 1; i <= n; i++) {
        if (items[i] != "" && data[items[i], "status"] != "closed")
            out = out (out == "" ? "" : ", ") items[i]
    }
    return out
}
END { if (prev_file) store() }
'

ticket_awk() {
    local program="$1"
    shift
    # /dev/null keeps an empty directory from making awk read stdin.
    awk "$@" "$AWK_TICKETS$program" "$TICKETS_DIR_PATH"/*.md /dev/null
}

ticket_path() {
    local id="$1" file match="" name
    if [[ -z "$id" || "$id" == */* ]]; then
        echo "Error: invalid ticket ID '$id'" >&2
        return 1
    fi
    if [[ -f "$TICKETS_DIR_PATH/$id.md" ]]; then
        printf '%s\n' "$TICKETS_DIR_PATH/$id.md"
        return
    fi
    for file in "$TICKETS_DIR_PATH"/*.md; do
        name=${file##*/}
        if [[ "${name%.md}" == *"$id"* ]]; then
            if [[ -n "$match" ]]; then
                echo "Error: ambiguous ID '$id' matches multiple tickets" >&2
                return 1
            fi
            match="$file"
        fi
    done
    if [[ -z "$match" ]]; then
        echo "Error: ticket '$id' not found" >&2
        return 1
    fi
    printf '%s\n' "$match"
}

# Replace one scalar or add/remove exact list members. Publish only valid output.
# Environment variables pass literal values without awk -v backslash conversion.
update_field() {
    local file="$1" field="$2" mode="$3" value="$4" tmp
    tmp=$(mktemp "${file}.tmp.XXXXXX")
    if ! cp -p "$file" "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    if TKT_FIELD="$field" TKT_MODE="$mode" TKT_VALUE="$value" awk "$AWK_FRONTMATTER"'
    BEGIN {
        target = ENVIRON["TKT_FIELD"]
        mode = ENVIRON["TKT_MODE"]
        value = ENVIRON["TKT_VALUE"]
    }
    function emit(current,    n, m, i, items, changes, have, out) {
        if (mode == "set") {
            print target ": " value
            return
        }
        n = parse_list(current, items)
        m = split(value, changes, " ")
        for (i = 1; i <= m; i++) have[changes[i]] = 1
        out = ""
        for (i = 1; i <= n; i++) {
            if (items[i] == "" || (mode == "remove" && items[i] in have)) continue
            if (mode == "add") delete have[items[i]]
            out = out (out == "" ? "" : ", ") items[i]
        }
        if (mode == "add") {
            for (i = 1; i <= m; i++) {
                if (changes[i] != "" && changes[i] in have) {
                    out = out (out == "" ? "" : ", ") changes[i]
                    delete have[changes[i]]
                }
            }
        }
        print target ": [" out "]"
    }
    front_start { opened = 1 }
    field_key == target {
        if (!found) emit(field_value)
        found = 1
        next
    }
    front_end {
        if (!found) emit("")
        closed = 1
    }
    { print }
    END {
        if (!opened || !closed) {
            print "Error: missing or incomplete frontmatter in " FILENAME > "/dev/stderr"
            exit 1
        }
    }
    ' "$file" > "$tmp"; then
        if cmp -s "$file" "$tmp"; then
            rm -f "$tmp"
        elif ! mv "$tmp" "$file"; then
            rm -f "$tmp"
            return 1
        fi
    else
        rm -f "$tmp"
        return 1
    fi
}

validate() {
    local name="$1" value="$2" choices="$3" valid
    for valid in $choices; do
        [[ "$value" == "$valid" ]] && return 0
    done
    echo "Error: invalid $name '$value'. Must be one of: $choices" >&2
    return 1
}

require_args() {
    local minimum="$1" actual="$2" usage="$3"
    if (( actual < minimum )); then
        echo "Usage: ${0##*/} $usage" >&2
        return 1
    fi
}

generate_id() {
    local dir_name prefix suffix
    dir_name=$(basename "$(dirname "$TICKETS_DIR_PATH")")
    dir_name=$(printf '%s' "$dir_name" | LC_ALL=C tr -cd 'a-zA-Z0-9_-')
    prefix=$(printf '%s\n' "$dir_name" | tr '_-' '  ' | awk '{for (i=1; i<=NF; i++) printf substr($i,1,1)}')
    [[ ${#prefix} -lt 2 ]] && prefix="${dir_name:0:3}"
    prefix=${prefix:-tkt}
    suffix=$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n') || return 1
    if [[ ! "$suffix" =~ ^[0-9a-f]{12}$ ]]; then
        echo "Error: cannot generate a random ticket ID" >&2
        return 1
    fi
    printf '%s-%s\n' "$prefix" "$suffix"
}

cmd_create() (
    local title="" description="" design="" acceptance=""
    local priority="$DEFAULT_PRIORITY" issue_type="$DEFAULT_ISSUE_TYPE"
    local assignee external_ref="" parent="" tags="" value
    assignee=$(git config user.name 2>/dev/null || true)
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--description|--design|--acceptance|-p|--priority|-t|--type|-a|--assignee|--external-ref|--parent|--tags)
                require_args 2 "$#" "create [title] $1 VALUE" || return 1
                case "$1" in
                    -d|--description) description="$2" ;;
                    --design) design="$2" ;;
                    --acceptance) acceptance="$2" ;;
                    -p|--priority) priority="$2" ;;
                    -t|--type) issue_type="$2" ;;
                    -a|--assignee) assignee="$2" ;;
                    --external-ref) external_ref="$2" ;;
                    --parent) parent="$2" ;;
                    --tags) tags="$2" ;;
                esac
                shift 2 ;;
            --) shift; title="$*"; break ;;
            -*) echo "Unknown option: $1" >&2; return 1 ;;
            *) title="$1"; shift ;;
        esac
    done
    validate type "$issue_type" "$VALID_TYPES" || return 1
    validate priority "$priority" "$VALID_PRIORITIES" || return 1
    if [[ -n "$parent" ]]; then
        parent=$(ticket_path "$parent") || return 1
        parent=${parent##*/}; parent=${parent%.md}
    fi
    for value in "$assignee" "$external_ref" "$tags"; do
        if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
            echo "Error: metadata values must be single-line text" >&2
            return 1
        fi
    done

    local id file now tmp attempt
    now=$(_iso_date)
    tmp=$(mktemp "$TICKETS_DIR_PATH/.create.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    for ((attempt=0; attempt<20; attempt++)); do
        id=$(generate_id)
        file="$TICKETS_DIR_PATH/$id.md"
        [[ -e "$file" || -L "$file" || -e "$TICKETS_DIR_PATH/archive/$id.md" || -L "$TICKETS_DIR_PATH/archive/$id.md" ]] && continue
        {
            printf '%s\n' '---' "id: $id" 'status: open' 'deps: []' 'links: []' \
                "created: $now" "type: $issue_type" "priority: $priority"
            [[ -z "$assignee" ]] || printf 'assignee: %s\n' "$assignee"
            [[ -z "$external_ref" ]] || printf 'external-ref: %s\n' "$external_ref"
            [[ -z "$parent" ]] || printf 'parent: %s\n' "$parent"
            [[ -z "$tags" ]] || printf 'tags: [%s]\n' "${tags//,/, }"
            printf '%s\n# %s\n\n' '---' "${title:-Untitled}"
            [[ -z "$description" ]] || printf '%s\n\n' "$description"
            [[ -z "$design" ]] || printf '## Design\n\n%s\n\n' "$design"
            [[ -z "$acceptance" ]] || printf '## Acceptance Criteria\n\n%s\n\n' "$acceptance"
        } > "$tmp"
        # Hard-link publication is atomic and never replaces an existing ticket.
        if ln "$tmp" "$file" 2>/dev/null; then
            printf '%s\n' "$id"
            return 0
        fi
        if [[ ! -e "$file" && ! -L "$file" ]]; then
            echo "Error: cannot create ticket '$file'" >&2
            return 1
        fi
    done
    echo "Error: could not allocate a unique ticket ID" >&2
    return 1
)

cmd_status() {
    require_args 2 "$#" 'status <id> <status>' || return 1
    validate status "$2" "$VALID_STATUSES" || return 1
    local file
    file=$(ticket_path "$1") || return 1
    update_field "$file" status set "$2"
    echo "Updated $(basename "$file" .md) -> $2"
}

cmd_dep_tree() {
    local full=0 root="" file
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) full=1 ;;
            -*) echo "Unknown option: $1" >&2; return 1 ;;
            *) root="$1" ;;
        esac
        shift
    done
    if [[ -z "$root" ]]; then
        echo "Usage: ${0##*/} dep tree [--full] <id>" >&2
        return 1
    fi
    file=$(ticket_path "$root") || return 1
    root=${file##*/}; root=${root%.md}
    ticket_awk '
    function walk(id, prefix,    n, items, i, child, connector, next_prefix, label, suffix) {
        on_path[id] = 1
        seen[id] = 1
        n = parse_list(data[id, "deps"], items)
        for (i = 1; i <= n; i++) {
            child = items[i]
            if (child == "") continue
            connector = (i == n ? "└── " : "├── ")
            next_prefix = prefix (i == n ? "    " : "│   ")
            label = !(child in files) ? "missing" : data[child, "status"]
            suffix = on_path[child] ? " (cycle)" : (!full && seen[child] ? " (seen)" : "")
            print prefix connector child " [" label "] " titles[child] suffix
            if (child in files && !on_path[child] && (full || !seen[child])) walk(child, next_prefix)
        }
        delete on_path[id]
    }
    END {
        print root " [" data[root, "status"] "] " titles[root]
        walk(root, "")
    }
    ' -v root="$root" -v full="$full"
}

cmd_dep_cycle() {
    ticket_awk '
    function visit(id,    n, items, i, child, j, cycle) {
        state[id] = 1
        path[++depth] = id
        position[id] = depth
        n = parse_list(data[id, "deps"], items)
        for (i = 1; i <= n; i++) {
            child = items[i]
            if (!(child in files) || data[child, "status"] == "closed") continue
            if (state[child] == 1) {
                cycle = ""
                for (j = position[child]; j <= depth; j++) cycle = cycle path[j] " -> "
                print "Cycle " ++cycles ": " cycle child
            } else if (!state[child]) visit(child)
        }
        depth--
        delete position[id]
        state[id] = 2
    }
    END {
        for (idx = 1; idx <= ticket_count; idx++) {
            id = ids[idx]
            if (data[id, "status"] != "closed" && !state[id]) visit(id)
        }
        if (!cycles) print "No dependency cycles found"
    }
    '
}

cmd_dep() {
    case "${1:-}" in
        tree) shift; cmd_dep_tree "$@"; return ;;
        cycle) shift; cmd_dep_cycle "$@"; return ;;
    esac
    change_dep add "$@"
}

change_dep() {
    local mode="$1" file dep_file dep_id
    shift
    require_args 2 "$#" 'dep/undep <id> <dependency-id>' || return 1
    file=$(ticket_path "$1") || return 1
    dep_file=$(ticket_path "$2") || return 1
    dep_id=${dep_file##*/}; dep_id=${dep_id%.md}
    if [[ "$mode" == add && "$file" == "$dep_file" ]]; then
        echo "Error: a ticket cannot depend on itself" >&2
        return 1
    fi
    update_field "$file" deps "$mode" "$dep_id"
    echo "Dependency updated: $(basename "$file" .md) -> $dep_id ($mode)"
}

cmd_link() {
    require_args 2 "$#" 'link <id> <id> [id...]' || return 1
    local -a files=()
    local arg file target others id
    for arg in "$@"; do
        file=$(ticket_path "$arg") || return 1
        files+=("$file")
    done
    for file in "${files[@]}"; do
        others=""
        for target in "${files[@]}"; do
            [[ "$file" == "$target" ]] && continue
            id=${target##*/}; id=${id%.md}
            others="$others $id"
        done
        [[ -z "$others" ]] || update_field "$file" links add "$others"
    done
    echo "Links updated"
}

cmd_unlink() {
    require_args 2 "$#" 'unlink <id> <target-id>' || return 1
    local file target id target_id
    file=$(ticket_path "$1") || return 1
    target=$(ticket_path "$2") || return 1
    id=${file##*/}; id=${id%.md}
    target_id=${target##*/}; target_id=${target_id%.md}
    update_field "$file" links remove "$target_id"
    update_field "$target" links remove "$id"
    echo "Removed link: $id <-> $target_id"
}

cmd_ls() {
    local mode=active assignee="" tag="" type="" limit=20 output id line mtime
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ready) mode=ready ;;
            --blocked) mode=blocked ;;
            --closed) mode=closed ;;
            -a) require_args 2 "$#" 'ls -a NAME' || return 1; assignee="$2"; shift ;;
            --assignee=*) assignee=${1#*=} ;;
            --type=*) type=${1#*=} ;;
            --tag=*) tag=${1#*=} ;;
            --limit=*) limit=${1#*=} ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac
        shift
    done
    if [[ ! "$limit" =~ ^[0-9]+$ ]]; then
        echo "Error: limit must be a non-negative integer" >&2
        return 1
    fi
    [[ -z "$type" ]] || validate type "$type" "$VALID_TYPES"
    local -a stat_args=(-c %Y)
    if [[ "$mode" == closed ]] && ! stat -c %Y "$TICKETS_DIR_PATH" >/dev/null 2>&1; then
        stat_args=(-f %m)
    fi
    output=$(TKT_ASSIGNEE="$assignee" TKT_TAG="$tag" ticket_awk '
    function has_tag(id, tag,    n, items, i) {
        n = parse_list(data[id, "tags"], items)
        for (i = 1; i <= n; i++) if (items[i] == tag) return 1
        return 0
    }
    END {
        for (idx = 1; idx <= ticket_count; idx++) {
            id = ids[idx]
            if (ENVIRON["TKT_ASSIGNEE"] != "" && data[id, "assignee"] != ENVIRON["TKT_ASSIGNEE"]) continue
            if (ENVIRON["TKT_TAG"] != "" && !has_tag(id, ENVIRON["TKT_TAG"])) continue
            if (type != "" && data[id, "type"] != type) continue
            status = data[id, "status"]
            blocked_by = blockers(id)
            if (mode == "closed") {
                if (status != "closed") continue
            } else {
                if (!active(id)) continue
                if (mode == "ready" && blocked_by != "") continue
                if (mode == "blocked" && blocked_by == "") continue
            }
            priority = data[id, "priority"]
            if (priority == "") priority = default_priority
            suffix = mode == "blocked" ? " <- [" blocked_by "]" : ""
            if (mode != "closed") printf "%s\t", priority
            printf "%s\t%-8s [P%s][%s] - %s%s\n", id, id, priority, status, titles[id], suffix
        }
    }
    ' -v mode="$mode" -v type="$type" -v default_priority="$DEFAULT_PRIORITY" |
        if [[ "$mode" == closed ]]; then
            while IFS=$'\t' read -r id line; do
                mtime=$(stat "${stat_args[@]}" "$TICKETS_DIR_PATH/$id.md") || exit 1
                printf '%s\t%s\t%s\n' "$mtime" "$id" "$line"
            done | LC_ALL=C sort -t $'\t' -k1,1nr -k2,2 | awk -v limit="$limit" 'NR <= limit'
        else
            LC_ALL=C sort -t $'\t' -k1,1n -k2,2
        fi | cut -f3-)
    if [[ -n "$output" ]]; then
        printf '%s\n' "$output"
    elif [[ "$mode" != closed || "$limit" != 0 ]]; then
        echo "No $mode tickets found"
    fi
}

cmd_cat() {
    require_args 1 "$#" 'cat <id>' || return 1
    local file id
    file=$(ticket_path "$1") || return 1
    id=${file##*/}; id=${id%.md}
    ticket_awk '
    function section(name) { print "\n## " name "\n" }
    function entry(id) {
        printf "- %s [%s] %s\n", id, (id in files ? data[id, "status"] : "missing"), titles[id]
    }
    END {
        file = files[target]
        line_number = 0; in_front = 0
        while ((getline line < file) > 0) {
            line_number++
            if (line_number == 1) in_front = (line == "---")
            else if (in_front && line == "---") in_front = 0
            if (in_front && line ~ /^parent:/ && data[target, "parent"] in files)
                print line "  # " titles[data[target, "parent"]]
            else print line
        }
        close(file)
        n = parse_list(blockers(target), items)
        if (n) section("Blockers")
        for (i = 1; i <= n; i++) entry(items[i])
        found = 0
        for (idx = 1; idx <= ticket_count; idx++) {
            id = ids[idx]
            if (data[id, "status"] == "closed") continue
            n = parse_list(data[id, "deps"], items)
            for (i = 1; i <= n; i++) if (items[i] == target) {
                if (!found++) section("Blocking")
                entry(id)
                break
            }
        }
        found = 0
        for (idx = 1; idx <= ticket_count; idx++) {
            id = ids[idx]
            if (data[id, "parent"] == target) {
                if (!found++) section("Children")
                entry(id)
            }
        }
        n = parse_list(data[target, "links"], items)
        if (n) section("Linked")
        for (i = 1; i <= n; i++) entry(items[i])
    }
    ' -v target="$id"
}

cmd_add_note() {
    require_args 1 "$#" 'add-note <id> [text]' || return 1
    local file note
    file=$(ticket_path "$1") || return 1
    shift
    if [[ $# -gt 0 ]]; then
        note="$*"
    elif [[ ! -t 0 ]]; then
        note=$(cat)
    else
        echo "Error: no note provided" >&2
        return 1
    fi
    if ! grep -q '^## Notes$' "$file"; then
        printf '\n## Notes\n' >> "$file"
    fi
    printf '\n**%s**\n\n%s\n' "$(_iso_date)" "$note" >> "$file"
    echo "Note added to $(basename "$file" .md)"
}

cmd_edit() {
    require_args 1 "$#" 'edit <id>' || return 1
    local file
    file=$(ticket_path "$1") || return 1
    if [[ -t 0 && -t 1 ]]; then
        "${EDITOR:-vi}" "$file"
    else
        echo "Edit ticket file: $file"
    fi
}

cmd_query() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: query requires jq" >&2
        return 1
    fi
    ticket_awk '
    BEGIN {
        for (code = 1; code < 32; code++) escapes[sprintf("%c", code)] = sprintf("\\u%04x", code)
        escapes["\\"] = "\\\\"
        escapes["\""] = "\\\""
    }
    function quote(value,    i, ch, out) {
        out = "\""
        for (i = 1; i <= length(value); i++) {
            ch = substr(value, i, 1)
            out = out (ch in escapes ? escapes[ch] : ch)
        }
        return out "\""
    }
    END {
        for (idx = 1; idx <= ticket_count; idx++) {
            id = ids[idx]
            printf "{"
            for (k = 1; k <= key_count[id]; k++) {
                key = keys[id, k]
                value = data[id, key]
                printf "%s%s:", (k == 1 ? "" : ","), quote(key)
                if (value ~ /^\[.*\]$/) {
                    n = parse_list(value, items)
                    printf "["
                    for (i = 1; i <= n; i++) printf "%s%s", (i == 1 ? "" : ","), quote(items[i])
                    printf "]"
                } else printf "%s", quote(value)
            }
            print "}"
        }
    }
    ' | jq -c "select(${1:-true})"
}

cmd_archive() {
    local to_archive id file archive_dir="$TICKETS_DIR_PATH/archive" count=0
    to_archive=$(ticket_awk '
    function edge(from, to) {
        if (to == "" || from == to || !(to in files) || ((from, to) in edges)) return
        edges[from, to] = edges[to, from] = 1
        neighbors[from] = neighbors[from] " " to
        neighbors[to] = neighbors[to] " " from
    }
    END {
        for (idx = 1; idx <= ticket_count; idx++) {
            id = ids[idx]
            n = parse_list(data[id, "deps"], items)
            for (i = 1; i <= n; i++) edge(id, items[i])
            n = parse_list(data[id, "links"], items)
            for (i = 1; i <= n; i++) edge(id, items[i])
            edge(id, data[id, "parent"])
            if (active(id)) {
                queue[++tail] = id
                reachable[id] = 1
            }
        }
        for (head = 1; head <= tail; head++) {
            n = split(neighbors[queue[head]], items, " ")
            for (i = 1; i <= n; i++) {
                id = items[i]
                if (id != "" && !reachable[id]) {
                    reachable[id] = 1
                    queue[++tail] = id
                }
            }
        }
        for (idx = 1; idx <= ticket_count; idx++) {
            id = ids[idx]
            if (data[id, "status"] == "closed" && !reachable[id]) print id
        }
    }
    ')
    if [[ -z "$to_archive" ]]; then
        echo "No tickets to archive"
        return
    fi
    mkdir -p "$archive_dir"
    while IFS= read -r id; do
        file="$TICKETS_DIR_PATH/$id.md"
        # Do not replace an archived ticket with the same ID.
        if [[ -e "$archive_dir/$id.md" || -L "$archive_dir/$id.md" ]] || ! ln "$file" "$archive_dir/$id.md"; then
            echo "Error: cannot archive '$id'; source ticket kept" >&2
            return 1
        fi
        rm "$file"
        count=$((count + 1))
    done <<< "$to_archive"
    echo "Archived $count ticket(s) to $archive_dir/"
}

cmd_help() {
    local cmd=${0##*/}
    cat <<EOF
$cmd - minimal ticket system with dependency tracking

Usage: $cmd <command> [args]

Commands:
  create [title] [options]   Create ticket, prints ID
    -d, --description TEXT     Description text
    --design TEXT              Design notes
    --acceptance TEXT          Acceptance criteria
    -t, --type TYPE            ${VALID_TYPES// /|} [default: $DEFAULT_ISSUE_TYPE]
    -p, --priority N           ${VALID_PRIORITIES// /|}, lower = higher priority [default: $DEFAULT_PRIORITY]
    -a, --assignee NAME        Assignee [default: git user.name]
    --external-ref REF         External reference (e.g., gh-123)
    --parent ID                Parent ticket ID
    --tags TAGS                Comma-separated tags
  start <id>                 Set status to in_progress
  close <id>                 Set status to closed
  reopen <id>                Set status to open
  status <id> <status>       Update status ($VALID_STATUSES)
  add-note <id> [text]       Append timestamped note (or pipe via stdin)
  archive                    Archive closed tickets with no active connections
  dep <id> <dep-id>          Add dependency (id depends on dep-id)
  undep <id> <dep-id>        Remove dependency
  dep tree [--full] <id>     Show tree; --full expands shared dependencies again
  dep cycle                  Find dependency cycles in unclosed tickets
  link <id> <id> [id...]     Link tickets together (symmetric)
  unlink <id> <target-id>    Remove link between tickets
  cat <id>                   View ticket and its connections
  edit <id>                  Open ticket in \$EDITOR
  query [jq-filter]          Output JSON objects, optionally filtered
  ls [options]              List tickets (default: active)
    --ready                   Active tickets with all dependencies closed
    --blocked                 Active tickets with unclosed dependencies
    --closed                  Closed tickets, newest modification first
    -a, --assignee=NAME        Filter by assignee
    --type=TYPE               Filter by type
    --tag=TAG                 Filter by tag
    --limit=N                 Closed-result limit [default: 20]

Searches parent directories for $TICKETS_DIR_NAME; TICKETS_DIR_PATH overrides the path.
Supports partial IDs. Archived tickets are stored in archive/ and excluded from queries.
EOF
}

case "${1:-help}" in
    help|--help|-h) cmd_help; exit 0 ;;
    create|start|close|reopen|status|dep|undep|link|unlink|ls|list|archive|cat|edit|add-note|query) ;;
    *) echo "Unknown command: $1" >&2; cmd_help >&2; exit 1 ;;
esac
init_tickets_dir
command="$1"
shift
case "$command" in
    create) cmd_create "$@" ;;
    start) require_args 1 "$#" 'start <id>'; cmd_status "$1" in_progress ;;
    close) require_args 1 "$#" 'close <id>'; cmd_status "$1" closed ;;
    reopen) require_args 1 "$#" 'reopen <id>'; cmd_status "$1" open ;;
    status) cmd_status "$@" ;;
    dep) cmd_dep "$@" ;;
    undep) change_dep remove "$@" ;;
    link) cmd_link "$@" ;;
    unlink) cmd_unlink "$@" ;;
    ls|list) cmd_ls "$@" ;;
    archive) cmd_archive "$@" ;;
    cat) cmd_cat "$@" ;;
    edit) cmd_edit "$@" ;;
    add-note) cmd_add_note "$@" ;;
    query) cmd_query "$@" ;;
esac
